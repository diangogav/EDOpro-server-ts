		"views": [
			{
				"id": "edopro-path",
				"label": "EDOPro duel path",
				"focus": ["clients", "hostserver", "edoroom", "core", "cards"],
				"note": "An EDOPro client joins a room; every duel spawns a C++ core child process over stdio."
			},
			{
				"id": "ygopro-path",
				"label": "YGOPro / Mercury path",
				"focus": ["clients", "ygoserver", "redis", "ygoroom", "windbot"],
				"note": "Mercury clients duel on a WASM core in a worker thread; WindBot rejoins as an ordinary client."
			},
			{
				"id": "matchmaking-path",
				"label": "Matchmaking",
				"focus": ["webui", "api", "ygoserver", "matchmaking", "ygoroom"],
				"note": "One queue, two front doors: HTTP enqueue/poll and in-band socket opcodes."
			},
			{
				"id": "ranking-path",
				"label": "Game over to ranking",
				"focus": ["edoroom", "ygoroom", "eventbus", "plugins", "postgres"],
				"note": "Both engines publish GAME_OVER; plugins turn it into ratings and stats."
			}
		]
	},
