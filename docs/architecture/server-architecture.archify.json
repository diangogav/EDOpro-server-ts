	"cards": [
		{
			"dot": "cyan",
			"title": "Two duel engines, two mechanisms",
			"items": [
				"EDOPro spawns core/CoreIntegrator as a child process per duel, over stdio",
				"YGOPro / Mercury runs the ocgcore WASM build in a worker thread"
			]
		},
		{
			"dot": "violet",
			"title": "Three event surfaces",
			"items": [
				"EventBus carries GAME_OVER only, published by both engines",
				"duel.* events use the synchronous DuelEventDispatcher, never the bus"
			]
		},
		{
			"dot": "emerald",
			"title": "Matchmaking and bots",
			"items": [
				"One queue, two front doors: HTTP enqueue/poll and in-band socket opcodes",
				"WindBot is asked over HTTP and dials back in as an ordinary TCP client"
			]
		}
