# ------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------
# "production" turns on production behavior (see src/index.ts)
NODE_ENV=development
# Ranking season number recorded with every match
SEASON=1
# Key for the admin HTTP endpoints
ADMIN_API_KEY=changeme
# Comma-separated CORS origins; unset means "*"
ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------
# Ports
# -------------------------------------
# EDOPro TCP host server
HOST_PORT=7911
# YGOPro ("Mercury") TCP server
YGOPRO_PORT=7711
# YGOPro WebSocket server (ticket auth). Default 4002
YGOPRO_WEBSOCKET_PORT=4002
# Heartbeat for YGOPro WebSocket clients. Default 15000
YGOPRO_WEBSOCKET_HEARTBEAT_MS=1
# HTTP API
HTTP_PORT=7922
# Room-list WebSocket (lobby)
WEBSOCKET_PORT=4000
# EDOPro WebSocket duel server. Default 4001
WEBSOCKET_DUEL_PORT=4001

# -------------------------------------
# PostgreSQL (shared with evolution-api through evolution-types)
# -------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PORT=5432
POSTGRES_USER=evolution
POSTGRES_PASSWORD=
POSTGRES_DB=evolution

# ------------------------------------------------------------------
# Redis / Valkey (tickets, rese
# ------------------------------------------------------------------
USE_REDIS=false
REDIS_URI=redis://localhost:6379

# ------------------------------------------------------------------
# Ranking
# ------------------------------------------------------------------
RANK_ENABLED=false
# Default ./config/rank-groups.json
RANK_GROUPS_PATH=./config/rank-

# -------------------------------------
# Rate limiting
# -------------------------------------
RATE_LIMIT_ENABLED=false
# Wrong-password attempts per r (Redis EXPIRE)
RATE_LIMIT=5
RATE_LIMIT_WINDOW=60
# Per-IP budget for YGOPro JOIN attempts. 0 denies every join. Default 60
RATE_LIMIT_JOIN=60
# In seconds. Default 60
RATE_LIMIT_JOIN_WINDOW=60

# -------------------------------------
# Resources (cards, scripts, banlists)
# -------------------------------------
# Default ./resources/current
RESOURCES_DIR=./resources/curre
# Default ./resources.manifest.json
MANIFEST_PATH=./resources.manif
# How often banlists and card data are reloaded. Default 600
RESOURCES_REFRESH_SECONDS=600
# Extra YGOPro script folders, comma-separated (optional)
YGOPRO_EXTRA_SCRIPTS=
# Release folders kept by scripts/setup_resources.sh. Default 2
RESOURCES_KEEP_RELEASES=2
# Token for private resource repos at container start (optional)
GH_PRIVATE_TOKEN=

# -------------------------------------
# Matches
# -------------------------------------
# Side-decking time limit in minutes. Default 3
SIDE_TIMEOUT_MINUTES=3
# Stable id per deployment slot; required in production with reserved duels
SERVER_INSTANCE_ID=

# -------------------------------------
# WindBot (AI opponents)
# -------------------------------------
# "true" or "1"; WINDBOT_ENDPOINT and WINDBOT_BOTLIST are then required
ENABLE_WINDBOT=false
WINDBOT_ENDPOINT=http://windbot:2399
WINDBOT_BOTLIST=./config/bots.j
# Host WindBot uses to connect back to this server. Default "windbot"
WINDBOT_MY_IP=windbot

# -------------------------------------
# Diagnostics
# -------------------------------------
# Logs EDOPro core IPC timings
IPC_METRICS_ENABLED=false
                          